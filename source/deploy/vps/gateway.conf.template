# BIOMIE v2 API gateway (nginx inside the "gateway" container).
# Rendered by deploy/vps/stackctl.py render-gateway; the keys are substituted
# from shared/stack.env and the rendered file is root-only (0600).
#
# Two servers:
#   8000 internal: web/worker containers and host-side ops (127.0.0.1:3141).
#                  Accepts the service key; admin endpoints allowed.
#   8001 public:   only reached through the host nginx location /supabase/
#                  (127.0.0.1:3140). Never accepts the service key and never
#                  exposes GoTrue admin endpoints.
#
# Logs never contain query strings, headers, cookies or bodies ($uri only).

map_hash_bucket_size 512;

log_format biomie_gw '$remote_addr xff="$http_x_forwarded_for" [$time_local] '
                     '"$request_method $uri" $status $body_bytes_sent '
                     'rt=$request_time server=$server_port';
access_log /dev/stdout biomie_gw;

map $http_apikey $biomie_apikey_kind {
  default "none";
  "__ANON_KEY__" "anon";
  "__SERVICE_KEY__" "service";
}
map $http_authorization $biomie_jwt_header {
  default $http_authorization;
  "" "Bearer __ANON_KEY__";
}
map $http_authorization $biomie_auth_is_service {
  default 0;
  "Bearer __SERVICE_KEY__" 1;
}

server {
  listen 8000;
  server_tokens off;
  client_max_body_size 8m;

  location = /health { access_log off; return 200 'ok'; }

  location /auth/v1/ {
    proxy_pass http://auth:9999/;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 60s;
  }

  location /rest/v1/ {
    if ($biomie_apikey_kind = "none") { return 401; }
    proxy_pass http://rest:3000/;
    proxy_set_header Authorization $biomie_jwt_header;
    proxy_set_header Host $http_host;
    proxy_read_timeout 300s;
  }

  location / { return 404; }
}

server {
  listen 8001;
  server_tokens off;
  client_max_body_size 1m;

  location = /health { access_log off; return 200 'ok'; }

  # GoTrue administration is never reachable from the internet.
  location ^~ /auth/v1/admin/ { return 403; }
  location = /auth/v1/invite { return 403; }

  location /auth/v1/ {
    if ($biomie_auth_is_service) { return 403; }
    proxy_pass http://auth:9999/;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_read_timeout 60s;
  }

  location /rest/v1/ {
    if ($biomie_apikey_kind != "anon") { return 401; }
    if ($biomie_auth_is_service) { return 403; }
    proxy_pass http://rest:3000/;
    proxy_set_header Authorization $biomie_jwt_header;
    proxy_set_header Host $http_host;
    proxy_read_timeout 120s;
  }

  location / { return 404; }
}
