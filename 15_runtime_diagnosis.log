NGINX server {

    server_name biomie.magmoveiscorporativos.com.br;

    root /var/www/biomie/live;
    index index.php index.html;

    charset utf-8;

    # BIOMIE V2 API staging
    location ^~ /supabase/ {
        access_log off;
        proxy_pass http://127.0.0.1:3140/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/biomie-security-headers.conf;
    }

    client_max_body_size 50m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # Cabeçalhos de segurança num lugar só. Toda location que declara o próprio
    # add_header precisa incluir o snippet de novo: no Nginx, um add_header na
    # location anula TODOS os herdados do server (achado da auditoria 21/09/2026).
    include /etc/nginx/snippets/biomie-security-headers.conf;

    # WEBHOOK ANTES DO STRIP: `rewrite ... last` encerra a fase de rewrites e
    # vai direto para a busca de location. Se o strip do /biomie rodar primeiro,
    # esta regra NUNCA e avaliada e a URL com prefixo cai em 404 (foi o que a
    # Omie recebeu). O prefixo e opcional para as duas formas funcionarem.
    rewrite "^/biomie/webhooks/omie/([a-z0-9_-]+)/([A-Za-z0-9_-]{32,128})/?$" /api/omie_webhook.php?company_slug=$1&path_token=$2 last;
    rewrite "^/webhooks/omie/([a-z0-9_-]+)/([A-Za-z0-9_-]{32,128})/?$" /api/omie_webhook.php?company_slug=$1&path_token=$2 last;

    # O sistema ainda gera URLs começando com /biomie.
    # O Nginx remove esse prefixo internamente, sem quebrar POST ou login.
    rewrite "^/biomie/?(.*)$" /$1 last;

    rewrite "^/(index|vendedores|pedidos|mercadorias|financeiro|plano_voo|plano_voo_metas|integracoes)\.html$" /$1.php redirect;


    location = / {
        return 302 /biomie/login.php;
    }

    # Segunda barreira para código-fonte (a primeira será a raiz em public/).
    # 404 e não 403: não confirma que o arquivo existe.
    location ^~ /services/ {
        return 404;
    }

    location ^~ /scripts/ {
        return 404;
    }

    location ~* \.(py|pyc|sh|sql|log|bak|old|ini)$ {
        return 404;
    }

    location ~* ^/(app|bin|config|cron|cronjobs|database|docs|install|storage|tests|tools|vendor|views|scratch)(/|$) {
        deny all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* /(composer\.(json|lock)|phpstan.*\.neon|.*\.(env|ini|log|jsonl|lock|sql|bak|backup|old|orig|swp|dist|example|md|map))$ {
        deny all;
    }

    location ~* ^/(sw\.js|site\.webmanifest|manifest\.json)$ {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/biomie-security-headers.conf;
    }

    location ~* \.(css|js|png|svg|ico|jpg|jpeg|webp|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        include /etc/nginx/snippets/biomie-security-headers.conf;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        try_files $uri =404;

        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param BIOMIE_OPERATION_SCOPE_ENFORCED 1;

        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 120;

        add_header Cache-Control "private, no-cache, must-revalidate, max-age=0" always;
        include /etc/nginx/snippets/biomie-security-headers.conf;
    }

    access_log /var/log/nginx/biomie-access.log biomie_masked;
    error_log /var/log/nginx/biomie-error.log;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/biomie.magmoveiscorporativos.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/biomie.magmoveiscorporativos.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = biomie.magmoveiscorporativos.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;

    server_name biomie.magmoveiscorporativos.com.br;
    return 404; # managed by Certbot


}
HEADERS # Cabeçalhos de segurança do BIomie — incluído no server e em cada location
# que tenha add_header próprio (senão os do server não chegam à resposta).
# A CSP não mora aqui: quem envia é o PHP, e está funcionando.
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# HSTS conservador desde 21/09/2026: 1 dia. Subir para 1 ano (31536000) depois
# de confirmar que tudo funciona só em HTTPS. Sem includeSubDomains/preload
# de propósito: afetariam outros subdomínios de magmoveiscorporativos.com.br.
add_header Strict-Transport-Security "max-age=86400" always;


